{
	"schemaVersion": 1,
	"id": "vault-manager",
	"version": "${version}",
	"name": "Vault Manager",
	"description": "Simple vault manager for Trial Chambers",
	"authors": [
		"gXLg"
	],
	"contact": {
		"homepage": "https://gXLg.dev/en",
		"sources": "https://github.com/gXLg/vault-manager",
		"issues": "https://github.com/gXLg/vault-manager/issues"
	},
	"license": "MIT",
	"icon": "assets/vault-manager/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"dev.gxlg.vaultmanager.VaultManager"
		]
	},
	"mixins": [
		{
			"config": "vault-manager.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.13",
		"minecraft": ">=1.21",
		"java": ">=21",
		"fabric-api": "*"
	}
}